    "/api/auth/verificar-correo": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Confirmar correo",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "email",
                "codigo"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "codigo": {
                  "type": "string",
                  "pattern": "^[0-9]{6}$"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Operación completada."
          },
          "400": {
            "description": "Código incorrecto, vencido o sin intentos."
          },
          "429": {
            "description": "Demasiados intentos.",
            "headers": {
              "Retry-After": {
                "type": "integer",
                "description": "Segundos para volver a intentar."
              }
            }
          }
        }
      }
    },
