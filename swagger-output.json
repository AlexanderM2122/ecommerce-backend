    "/api/auth/verificar-recuperacion": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Verificar código de recuperación",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "email",
                "codigo"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "codigo": {
                  "type": "string",
                  "pattern": "^[0-9]{6}$"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Código confirmado. Usa el token de un solo uso para restablecer la contraseña.",
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Código incorrecto, vencido o sin intentos."
          },
          "429": {
            "description": "Demasiados intentos.",
            "headers": {
              "Retry-After": {
                "type": "integer",
                "description": "Segundos para volver a intentar."
              }
            }
          }
        }
      }
    },
    "/api/auth/cambiar-password": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Cambiar la contraseña de la cuenta autenticada",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "passwordActual",
                "password"
              ],
              "properties": {
                "passwordActual": {
                  "type": "string",
                  "format": "password"
                },
                "password": {
                  "type": "string",
                  "format": "password"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Contraseña actualizada. Las sesiones anteriores quedan invalidadas."
          },
          "400": {
            "description": "Contraseña actual incorrecta o contraseña nueva no válida."
          },
          "401": {
            "description": "Sesión inválida o vencida."
          },
          "403": {
            "description": "Acceso denegado."
          },
          "429": {
            "description": "Demasiados intentos."
          }
        }
      }
    }
  },
