    "/api/auth/": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "email",
                "password"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email",
                  "maxLength": 254
                },
                "password": {
                  "type": "string",
                  "format": "password"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación completada."
          },
          "202": {
            "description": "Se requiere segundo factor. Envía reto y código a /api/auth/mfa/login.",
            "schema": {
              "type": "object",
              "properties": {
                "reto": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Datos, código o enlace inválidos."
          },
          "401": {
            "description": "Credenciales, sesión o reto inválidos."
          },
          "403": {
            "description": "Correo pendiente de verificación. Presenta la pantalla de código.",
            "schema": {
              "type": "object",
              "properties": {
                "codigo": {
                  "type": "string",
                  "enum": [
                    "correo_pendiente"
                  ]
                },
                "email": {
                  "type": "string",
                  "format": "email"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos.",
            "headers": {
              "Retry-After": {
                "type": "integer",
                "description": "Segundos para volver a intentar."
              }
            }
          }
        }
      }
    },
    "/api/auth/registro": {
