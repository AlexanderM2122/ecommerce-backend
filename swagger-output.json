                "nombre": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Cuenta creada. El correo de verificación se envía en segundo plano."
          },
          "400": {
            "description": "Datos, código o enlace inválidos."
          },
          "409": {
            "description": "Conflicto con el estado de la cuenta."
          },
          "429": {
            "description": "Demasiados intentos.",
            "headers": {
              "Retry-After": {
                "type": "integer",
                "description": "Segundos para volver a intentar."
              }
            }
          },
          "503": {
            "description": "Servicio de correo sin configurar."
          }
        }
      }
    },
    "/api/auth/reenviar-verificacion": {
      "post": {
        "tags": [
